<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Hình nền -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Lớp tối nhẹ phía trên để chữ đồng hồ dễ đọc -->
    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/shade_top" />

    <!-- Lớp tối phía dưới cho hàng app -->
    <View
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="@drawable/shade_bottom" />

    <!-- Đồng hồ góc trên trái -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="54sp"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#AA000000"
            android:shadowRadius="6" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, dd/MM/yyyy"
            android:format24Hour="EEEE, dd/MM/yyyy"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:shadowColor="#AA000000"
            android:shadowRadius="6" />
    </LinearLayout>

    <!-- Hàng app dưới đáy -->
    <HorizontalScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false" />
    </HorizontalScrollView>
</FrameLayout>
