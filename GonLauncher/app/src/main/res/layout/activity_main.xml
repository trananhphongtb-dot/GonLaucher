<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Hình nền -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Lớp tối nhẹ phía trên để chữ đồng hồ dễ đọc -->
    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/shade_top" />

    <!-- Lớp tối phía dưới cho hàng app -->
    <View
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="@drawable/shade_bottom" />

    <!-- Đồng hồ 1 dòng ngang trên cùng: 01:02  Chủ Nhật 25-12-2026 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="26dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#AA000000"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:textColor="#E6FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:shadowColor="#AA000000"
            android:shadowRadius="6" />
    </LinearLayout>

    <!-- Phiên bản + trạng thái nút Home (góc trên phải) -->
    <TextView
        android:id="@+id/ver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginRight="48dp"
        android:textColor="#CCF2F4F6"
        android:textSize="14sp"
        android:shadowColor="#AA000000"
        android:shadowRadius="4" />

    <!-- Hàng app dưới đáy -->
    <HorizontalScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false" />
    </HorizontalScrollView>
</FrameLayout>
