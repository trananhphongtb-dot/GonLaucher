<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF101418</color>
    <color name="tile">#FF1E252C</color>
    <color name="text">#FFF2F4F6</color>
    <color name="text_dim">#FF9AA4AE</color>
    <color name="accent">#FF4FC3F7</color>

    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
